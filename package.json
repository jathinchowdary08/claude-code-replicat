{
  "name": "agent-code",
  "version": "0.1.0",
  "description": "A faithful, production-grade Claude Code-class terminal AI coding agent.",
  "type": "module",
  "bin": {
    "acode": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "claude",
    "anthropic",
    "coding-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.6",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "eslint": "^10.4.1",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
